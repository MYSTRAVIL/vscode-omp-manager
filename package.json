{
  "name": "omp-manager",
  "displayName": "OMP Session Manager",
  "description": "Oh My Pi sidebar: usage limits, session history, one-click resume, and terminal restore across VS Code restarts.",
  "version": "0.1.1",
  "publisher": "mystravil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MYSTRAVIL/vscode-omp-manager.git"
  },
  "bugs": {
    "url": "https://github.com/MYSTRAVIL/vscode-omp-manager/issues"
  },
  "homepage": "https://github.com/MYSTRAVIL/vscode-omp-manager#readme",
  "keywords": [
    "omp",
    "oh-my-pi",
    "agent",
    "terminal",
    "sessions"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omp",
          "title": "OMP",
          "icon": "media/omp.svg"
        }
      ]
    },
    "views": {
      "omp": [
        {
          "type": "webview",
          "id": "omp.main",
          "name": "OMP"
        }
      ]
    },
    "commands": [
      {
        "command": "omp.newSession",
        "title": "New Session",
        "category": "OMP",
        "icon": "$(add)"
      },
      {
        "command": "omp.resumeSession",
        "title": "Resume Session...",
        "category": "OMP"
      },
      {
        "command": "omp.refresh",
        "title": "Refresh",
        "category": "OMP",
        "icon": "$(refresh)"
      },
      {
        "command": "omp.session.openInEditor",
        "title": "Open in Editor",
        "category": "OMP"
      },
      {
        "command": "omp.session.openInPanel",
        "title": "Open in Panel",
        "category": "OMP"
      },
      {
        "command": "omp.session.copyId",
        "title": "Copy Session ID",
        "category": "OMP"
      },
      {
        "command": "omp.session.copyPath",
        "title": "Copy Session File Path",
        "category": "OMP"
      },
      {
        "command": "omp.session.reveal",
        "title": "Reveal Session File",
        "category": "OMP"
      },
      {
        "command": "omp.session.delete",
        "title": "Delete Session...",
        "category": "OMP"
      },
      {
        "command": "omp.focusNextWaiting",
        "title": "Focus Next Session Needing Input",
        "category": "OMP"
      }
    ],
    "keybindings": [
      {
        "command": "omp.newSession",
        "key": "ctrl+alt+o n",
        "mac": "cmd+alt+o n"
      },
      {
        "command": "omp.resumeSession",
        "key": "ctrl+alt+o r",
        "mac": "cmd+alt+o r"
      },
      {
        "command": "omp.focusNextWaiting",
        "key": "ctrl+alt+o w",
        "mac": "cmd+alt+o w"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "omp.newSession",
          "when": "view == omp.main",
          "group": "navigation@1"
        },
        {
          "command": "omp.refresh",
          "when": "view == omp.main",
          "group": "navigation@2"
        }
      ],
      "webview/context": [
        {
          "command": "omp.session.openInEditor",
          "when": "webviewId == 'omp.main' && webviewSection == 'session'",
          "group": "1_open@1"
        },
        {
          "command": "omp.session.openInPanel",
          "when": "webviewId == 'omp.main' && webviewSection == 'session'",
          "group": "1_open@2"
        },
        {
          "command": "omp.session.copyId",
          "when": "webviewId == 'omp.main' && webviewSection == 'session'",
          "group": "2_copy@1"
        },
        {
          "command": "omp.session.copyPath",
          "when": "webviewId == 'omp.main' && webviewSection == 'session'",
          "group": "2_copy@2"
        },
        {
          "command": "omp.session.reveal",
          "when": "webviewId == 'omp.main' && webviewSection == 'session'",
          "group": "3_file@1"
        },
        {
          "command": "omp.session.delete",
          "when": "webviewId == 'omp.main' && webviewSection == 'session' && !sessionOpen",
          "group": "4_delete@1"
        }
      ],
      "commandPalette": [
        {
          "command": "omp.session.openInEditor",
          "when": "false"
        },
        {
          "command": "omp.session.openInPanel",
          "when": "false"
        },
        {
          "command": "omp.session.copyId",
          "when": "false"
        },
        {
          "command": "omp.session.copyPath",
          "when": "false"
        },
        {
          "command": "omp.session.reveal",
          "when": "false"
        },
        {
          "command": "omp.session.delete",
          "when": "false"
        }
      ]
    },
    "configuration": [
      {
        "title": "Launch",
        "order": 1,
        "properties": {
          "omp.executable": {
            "type": "string",
            "default": "omp",
            "description": "omp executable name or absolute path."
          },
          "omp.agentDir": {
            "type": "string",
            "default": "",
            "description": "omp agent directory. Empty uses PI_CODING_AGENT_DIR, then ~/.omp/agent."
          },
          "omp.extraArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "markdownDescription": "Extra command-line arguments for every omp this extension launches, for example `[\"--model\", \"sonnet\"]`."
          },
          "omp.env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "description": "Extra environment variables for every omp this extension launches."
          },
          "omp.newSessionCwd": {
            "type": "string",
            "enum": [
              "workspaceRoot",
              "activeFileFolder",
              "ask"
            ],
            "enumDescriptions": [
              "The workspace folder. Multi-root workspaces ask which folder.",
              "The folder of the active editor's file. Falls back to the workspace folder.",
              "Always pick a folder."
            ],
            "default": "workspaceRoot",
            "description": "Where New Session starts omp."
          },
          "omp.terminalLocation": {
            "type": "string",
            "enum": [
              "editor",
              "panel"
            ],
            "default": "editor",
            "markdownDescription": "Where omp sessions open. VS Code starts an `editor` terminal only once its tab is laid out, so it can appear a moment later than a `panel` one, and restored sessions open one after another."
          },
          "omp.terminalIcon": {
            "type": "string",
            "default": "sparkle",
            "markdownDescription": "[Codicon](https://microsoft.github.io/vscode-codicons/dist/codicon.html) id for omp terminal tabs, without `$()`."
          },
          "omp.terminalColor": {
            "type": "string",
            "default": "",
            "markdownDescription": "Theme color id for omp terminal tabs, for example `terminal.ansiMagenta`. Empty uses the default color."
          },
          "omp.restoreOnStartup": {
            "type": "string",
            "enum": [
              "always",
              "ask",
              "never"
            ],
            "enumDescriptions": [
              "Reopen them without asking.",
              "Ask once before reopening them.",
              "Do not reopen them."
            ],
            "default": "always",
            "description": "Reopen the omp sessions that were open when VS Code closed, in the same order."
          }
        }
      },
      {
        "title": "Usage",
        "order": 2,
        "properties": {
          "omp.usage.refreshMinutes": {
            "type": "number",
            "default": 5,
            "minimum": 1,
            "description": "How often usage refreshes while the sidebar or the status bar item shows it."
          },
          "omp.usage.warnPercent": {
            "type": "number",
            "default": 80,
            "minimum": 1,
            "maximum": 100,
            "description": "Usage percent at which a meter turns to the warning color."
          },
          "omp.usage.providers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "anthropic",
                "openai-codex",
                "openai",
                "google-gemini-cli"
              ]
            },
            "uniqueItems": true,
            "default": [],
            "description": "Providers to show. Empty shows every provider omp reports."
          },
          "omp.usage.resetDisplay": {
            "type": "string",
            "enum": [
              "both",
              "countdown",
              "time"
            ],
            "enumDescriptions": [
              "Countdown on the left, local reset time on the right.",
              "Only the countdown.",
              "Only the local reset time."
            ],
            "default": "both",
            "description": "What each usage meter shows about its reset."
          },
          "omp.usage.showPace": {
            "type": "boolean",
            "default": true,
            "description": "Mark where each meter would be at an even pace through its window, and show how far under or over that pace usage is."
          },
          "omp.usage.statusBar": {
            "type": "boolean",
            "default": false,
            "description": "Show the most-used limit in the status bar."
          },
          "omp.usage.notifyOnWarn": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Notify once when a limit reaches `#omp.usage.warnPercent#`. Notifies again after the limit resets."
          }
        }
      },
      {
        "title": "Sessions",
        "order": 3,
        "properties": {
          "omp.sessions.scope": {
            "type": "string",
            "enum": [
              "workspace",
              "all"
            ],
            "enumDescriptions": [
              "Sessions started in or under the open workspace folders. All sessions when no folder is open.",
              "Every omp session."
            ],
            "default": "workspace",
            "description": "Which sessions the sidebar and Resume Session list."
          },
          "omp.sessions.maxShown": {
            "type": "number",
            "default": 300,
            "minimum": 1,
            "description": "Most sessions the sidebar lists. Open sessions always show."
          },
          "omp.sessions.showEmpty": {
            "type": "boolean",
            "default": false,
            "description": "List sessions that have no prompt yet."
          },
          "omp.sessions.sortBy": {
            "type": "string",
            "enum": [
              "modified",
              "created"
            ],
            "default": "modified",
            "description": "Order of the session list, newest first."
          },
          "omp.sessions.groupBy": {
            "type": "string",
            "enum": [
              "none",
              "date",
              "folder"
            ],
            "enumDescriptions": [
              "One flat list, open sessions first.",
              "Open, then Today, Yesterday, This Week, Older.",
              "Open, then the folder each session ran in."
            ],
            "default": "date",
            "description": "How the session list is grouped."
          }
        }
      },
      {
        "title": "Notifications",
        "order": 4,
        "properties": {
          "omp.notify.onFinish": {
            "type": "boolean",
            "default": true,
            "description": "Notify when a session finishes while its terminal tab is not in view."
          },
          "omp.notify.onInput": {
            "type": "boolean",
            "default": true,
            "description": "Notify when a session asks a question while its terminal tab is not in view."
          },
          "omp.notify.minWorkSeconds": {
            "type": "number",
            "default": 10,
            "minimum": 0,
            "description": "Skip the finish notification when the agent worked for less than this many seconds. Questions always notify."
          },
          "omp.notify.style": {
            "type": "string",
            "enum": [
              "vscode",
              "system",
              "both"
            ],
            "enumDescriptions": [
              "A VS Code notification.",
              "An operating system notification with its sound, shown only while VS Code is not focused. Falls back to VS Code when unavailable.",
              "A VS Code notification, plus a system notification while VS Code is not focused."
            ],
            "default": "vscode",
            "description": "How session notifications appear."
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p tsconfig.test.json && node --test --require ./out-test/test/setup.js \"out-test/test/*.test.js\"",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}
