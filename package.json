{
  "name": "omp-manager",
  "displayName": "OMP Session Manager",
  "description": "Oh My Pi sidebar: usage limits, session history, one-click resume, and terminal restore across VS Code restarts.",
  "version": "0.1.0",
  "publisher": "mystravil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MYSTRAVIL/vscode-omp-manager.git"
  },
  "bugs": {
    "url": "https://github.com/MYSTRAVIL/vscode-omp-manager/issues"
  },
  "homepage": "https://github.com/MYSTRAVIL/vscode-omp-manager#readme",
  "keywords": [
    "omp",
    "oh-my-pi",
    "agent",
    "terminal",
    "sessions"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omp",
          "title": "OMP",
          "icon": "media/omp.svg"
        }
      ]
    },
    "views": {
      "omp": [
        {
          "type": "webview",
          "id": "omp.main",
          "name": "OMP"
        }
      ]
    },
    "commands": [
      {
        "command": "omp.newSession",
        "title": "New Session",
        "category": "OMP",
        "icon": "$(add)"
      },
      {
        "command": "omp.resumeSession",
        "title": "Resume Session...",
        "category": "OMP"
      },
      {
        "command": "omp.refresh",
        "title": "Refresh",
        "category": "OMP",
        "icon": "$(refresh)"
      },
      {
        "command": "omp.session.openInEditor",
        "title": "Open in Editor",
        "category": "OMP"
      },
      {
        "command": "omp.session.openInPanel",
        "title": "Open in Panel",
        "category": "OMP"
      },
      {
        "command": "omp.session.copyId",
        "title": "Copy Session ID",
        "category": "OMP"
      },
      {
        "command": "omp.session.copyPath",
        "title": "Copy Session File Path",
        "category": "OMP"
      },
      {
        "command": "omp.session.reveal",
        "title": "Reveal Session File",
        "category": "OMP"
      },
      {
        "command": "omp.session.delete",
        "title": "Delete Session...",
        "category": "OMP"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "omp.newSession",
          "when": "view == omp.main",
          "group": "navigation@1"
        },
        {
          "command": "omp.refresh",
          "when": "view == omp.main",
          "group": "navigation@2"
        }
      ],
      "webview/context": [
        {
          "command": "omp.session.openInEditor",
          "when": "webviewId == 'omp.main' && webviewSection == 'session'",
          "group": "1_open@1"
        },
        {
          "command": "omp.session.openInPanel",
          "when": "webviewId == 'omp.main' && webviewSection == 'session'",
          "group": "1_open@2"
        },
        {
          "command": "omp.session.copyId",
          "when": "webviewId == 'omp.main' && webviewSection == 'session'",
          "group": "2_copy@1"
        },
        {
          "command": "omp.session.copyPath",
          "when": "webviewId == 'omp.main' && webviewSection == 'session'",
          "group": "2_copy@2"
        },
        {
          "command": "omp.session.reveal",
          "when": "webviewId == 'omp.main' && webviewSection == 'session'",
          "group": "3_file@1"
        },
        {
          "command": "omp.session.delete",
          "when": "webviewId == 'omp.main' && webviewSection == 'session' && !sessionOpen",
          "group": "4_delete@1"
        }
      ],
      "commandPalette": [
        { "command": "omp.session.openInEditor", "when": "false" },
        { "command": "omp.session.openInPanel", "when": "false" },
        { "command": "omp.session.copyId", "when": "false" },
        { "command": "omp.session.copyPath", "when": "false" },
        { "command": "omp.session.reveal", "when": "false" },
        { "command": "omp.session.delete", "when": "false" }
      ]
    },
    "configuration": {
      "title": "OMP",
      "properties": {
        "omp.executable": {
          "type": "string",
          "default": "omp",
          "description": "omp executable name or absolute path."
        },
        "omp.agentDir": {
          "type": "string",
          "default": "",
          "description": "omp agent directory. Empty uses PI_CODING_AGENT_DIR, then ~/.omp/agent."
        },
        "omp.terminalLocation": {
          "type": "string",
          "enum": [
            "editor",
            "panel"
          ],
          "default": "editor",
          "description": "Where omp sessions open."
        },
        "omp.restoreOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Reopen the omp sessions that were open when VS Code closed, in the same order."
        },
        "omp.usageRefreshMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "How often the usage view refreshes while visible."
        },
        "omp.notifyWhenDone": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when an omp session finishes or asks a question while its terminal tab is not in view."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p tsconfig.test.json && node --test --require ./out-test/test/setup.js \"out-test/test/*.test.js\"",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}
